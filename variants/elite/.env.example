# Copy to .env in the deploy directory for deployment. Never commit a populated
# copy: .env is gitignored, and the CI job installs it with mode 0600.
#
# Nothing here goes into deploy/config.dev.json — that file is committed and
# deliberately carries no credentials.

# Host port published by the nginx container. The app itself publishes nothing.
PUBLIC_HTTP_PORT=18090

# Bearer token the server enforces. Generate with: openssl rand -hex 32
# Read once at startup (deps.py:73); empty = authentication DISABLED.
HMS_SERVER_TOKEN=

# DeepSeek API key. The committed config omits api_key, so this environment
# variable is the only place the secret lives (llms/deepseek.py:127).
DEEPSEEK_API_KEY=

# Outbound proxy. The dev box has no direct route to api.deepseek.com, so the
# app container must go through this. Left empty = direct egress.
HTTP_PROXY=http://172.31.32.75:8888
HTTPS_PROXY=http://172.31.32.75:8888

# NO_PROXY is deliberately NOT configurable here: docker-compose.yml hardcodes
# it as a literal so a runner shell cannot override it. Setting it in .env would
# have no effect, which is worse than not offering it.
